# Copy to `.env` (or export in your shell) before running `python main.py`.

# Required: OpenAI API key. Falls back to the per-request
# X-OpenAI-API-Key header if unset; if neither is supplied, every
# model call will fail at runtime.
OPENAI_API_KEY_TSNEXT2025=

# Optional: OpenAI request timeout, in seconds. Default: 30.
# ROGUEAI_OPENAI_TIMEOUT=30

# Optional: drop sessions older than N days at startup.
# Default: 30. Set to 0 to disable purging.
# ROGUEAI_SESSION_TTL_DAYS=30
